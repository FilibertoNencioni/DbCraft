<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ODBC drivers are loaded from /opt/homebrew, /usr/local, … and need
	     unrestricted file system and network access: no App Sandbox. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<!-- Lets the relaunch in AppDelegate.swift point SQL Server drivers at
	     openssl@3 via DYLD_LIBRARY_PATH under the hardened runtime. -->
	<key>com.apple.security.cs.allow-dyld-environment-variables</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
